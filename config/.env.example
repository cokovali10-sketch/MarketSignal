# --- Telegram ---
BOT_TOKEN=123456:YOUR_BOT_TOKEN_FROM_BOTFATHER

# --- Оплата ---
# Режим: manual (кнопка «Я оплатил» + подтверждение админом) или auto (по вебхуку платёжки)
PAYMENT_MODE=manual
# Ссылка на оплату (ЮMoney/крипта) — при выборе тарифа бот откроет её
PAYMENT_LINK=
# Username админа (без @) — контакт в меню оплаты
ADMIN_USERNAME=
# Токен Crypto Pay API (@CryptoBot → Разработчикам → API Token) для авто-оплаты
CRYPTO_PAY_TOKEN=
# Курс USDT к рублю для расчёта цены в USDT
USDT_RATE=95.0

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///data/marketsignal.db

# --- Парсеры ---
# Минимальная пауза между запросами к WB/Ozon (секунды)
WB_REQUEST_INTERVAL=1.0
OZON_REQUEST_INTERVAL=1.0
# Количество параллельных задач парсинга
PARSER_CONCURRENCY=5
# Проверять SSL-сертификаты (false если WB отдаёт ошибку сертификата)
SSL_VERIFY=true
# HTTP-прокси для обхода гео-блокировок WB: http://login:pass@host:port
HTTP_PROXY=
# Число попыток запроса при 429/5xx/сетевой ошибке
HTTP_RETRIES=3

# --- Планировщик ---
# Интервал проверки цен (минуты)
TRACK_INTERVAL_MIN=30

# --- Админ ---
# ID Telegram-аккаунта владельца (число). Узнать: @userinfobot
ADMIN_IDS=123456789

# --- Ozon (опционально, для своих продаж) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- Wildberries (опционально, API продавца) ---
WB_API_KEY=
